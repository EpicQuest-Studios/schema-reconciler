<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>studio.epicquest.schema</groupId>
    <artifactId>schema-reconciler-parent</artifactId>
    <version>0.1.6</version>
    <packaging>pom</packaging>

    <name>Schema Reconciler</name>
    <description>Declarative, data-safe schema reconciliation for relational databases in Java.</description>
    <url>https://github.com/EpicQuest-Studios/schema-reconciler</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/EpicQuest-Studios/schema-reconciler</url>
        <connection>scm:git:git://github.com/EpicQuest-Studios/schema-reconciler.git</connection>
        <developerConnection>scm:git:git@github.com:EpicQuest-Studios/schema-reconciler.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/EpicQuest-Studios/schema-reconciler/issues</url>
    </issueManagement>

    <developers>
        <developer>
            <id>mrepak</id>
        </developer>
    </developers>

    <modules>
        <module>schema-reconciler-core</module>
        <module>schema-reconciler-postgresql</module>
        <module>schema-reconciler-tck</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-10-24T00:00:00Z</project.build.outputTimestamp>

        <junit.version>5.12.2</junit.version>
        <postgresql.version>42.7.7</postgresql.version>
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>studio.epicquest.schema</groupId>
                <artifactId>schema-reconciler-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>studio.epicquest.schema</groupId>
                <artifactId>schema-reconciler-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
