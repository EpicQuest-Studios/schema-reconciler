<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>studio.epicquest.schema</groupId>
        <artifactId>schema-reconciler-parent</artifactId>
        <version>0.9.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>schema-reconciler-postgresql</artifactId>
    <name>Schema Reconciler PostgreSQL Dialect</name>
    <description>PostgreSQL 14+ dialect, the reference implementation.</description>

    <dependencies>
        <dependency>
            <groupId>studio.epicquest.schema</groupId>
            <artifactId>schema-reconciler-core</artifactId>
        </dependency>
        <!-- Provided by the application at runtime. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>studio.epicquest.schema</groupId>
            <artifactId>schema-reconciler-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- corpus + deployment fixtures live in java/fixtures, shared with the
             TypeScript port — they land on the test classpath unchanged -->
        <testResources>
            <testResource>
                <directory>../fixtures</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests run on the class path: the TCK is an automatic-module
                         jar and test classes are not part of the dialect module. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
